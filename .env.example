# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/eduflow?retryWrites=true&w=majority

# --- JWT ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters and different from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=eduflow-api
JWT_AUDIENCE=eduflow-app
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS / cookies ---
# Comma-separated frontend origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# strict | lax | none  ("none" only if frontend and API are on different sites; requires HTTPS)
COOKIE_SAMESITE=strict
# Optional, e.g. .eduflow.com to share the cookie across subdomains
# COOKIE_DOMAIN=

# Number of reverse proxies in front of the app (e.g. 1 behind Nginx/Render/Heroku)
TRUST_PROXY=0

# Optional: only these IPs may call /api/admin (comma-separated). Empty = any IP.
ADMIN_IP_ALLOWLIST=

# --- Encryption of stored secrets ---
# Needed to turn on automatic WhatsApp sending (encrypts each school's access token).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep it safe: changing it makes saved tokens unreadable (schools re-enter them).
# DATA_ENCRYPTION_KEY=

# --- WhatsApp Business (Cloud API) ---
# WHATSAPP_GRAPH_VERSION=v22.0
# Webhook for delivery/read receipts: callback URL = https://<your-api>/api/whatsapp/webhook
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
